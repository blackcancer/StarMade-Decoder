{
  "name": "starmade-decoder",
  "version": "1.5.0",
  "description": "TypeScript SDK to read/write StarMade save files \u2014 faithful port of the Java Tag format",
  "type": "module",
  "license": "MIT",
  "author": "InitSysRev <init-sys-rev@hotmail.com>",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "test": "node --no-experimental-require-module --import tsx/esm --no-warnings node_modules/mocha/bin/mocha.js",
    "coverage": "c8 --reporter=text --reporter=html --reporter=json-summary npm test",
    "coverage:check": "c8 --check-coverage --lines 70 --functions 70 --branches 60 --statements 70 npm test",
    "docs:check": "node scripts/check-jsdoc-coverage.mjs",
    "samples:fetch-starmadedock": "node scripts/fetch-starmadedock-samples.mjs",
    "clean": "rimraf dist coverage",
    "prepublishOnly": "npm run build && npm run docs:check && npm test",
    "test:interop": "node scripts/check-java-interop.mjs",
    "test:package": "node scripts/check-package-consumer.mjs",
    "coverage:verify": "c8 check-coverage --lines 70 --functions 70 --branches 60 --statements 70"
  },
  "devDependencies": {
    "@types/adm-zip": "^0.5.8",
    "@types/chai": "^4.3.0",
    "@types/mocha": "^10.0.0",
    "@types/node": "^20.19.40",
    "c8": "^11.0.0",
    "chai": "^5.1.0",
    "mocha": "^12.0.2",
    "rimraf": "^5.0.0",
    "ts-node": "^10.9.0",
    "tsx": "^4.21.0",
    "typescript": "^5.5.0"
  },
  "engines": {
    "node": ">=20.19.0"
  },
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "files": [
    "dist",
    "docs",
    "README.md",
    "CHANGELOG.md",
    "LICENSE"
  ],
  "repository": {
    "type": "git",
    "url": "https://github.com/blackcancer/StarMade-Decoder"
  },
  "homepage": "https://github.com/blackcancer/StarMade-Decoder#readme",
  "keywords": [
    "starmade",
    "nbt",
    "binary",
    "parser",
    "sdk",
    "blueprint",
    "save-file",
    "smd3",
    "sment",
    "decoder"
  ],
  "dependencies": {
    "adm-zip": "^0.6.1",
    "fast-xml-parser": "^5.7.3"
  }
}
