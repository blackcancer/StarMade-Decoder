{
  "all": true,
  "src": [
    "src"
  ],
  "include": [
    "src/**/*.ts"
  ],
  "exclude": [],
  "reporter": [
    "text",
    "html",
    "json",
    "json-summary",
    "lcov"
  ],
  "exclude-after-remap": true,
  "check-coverage": true,
  "per-file": true,
  "lines": 100,
  "branches": 100,
  "statements": 100
}
